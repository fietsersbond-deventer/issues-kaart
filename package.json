{
  "name": "fietsersbond-onderwerpen",
  "version": "1.0.0",
  "description": "Interactieve kaart voor het melden en beheren van fietsgerelateerde onderwerpen in Deventer",
  "author": "Fietsersbond Deventer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fietsersbond-deventer/issues-kaart.git"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --inspect --host",
    "build": "nuxt build",
    "start": "nuxt start",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings=0 && pnpm format:check",
    "lint:fix": "eslint . --fix --max-warnings=0 && pnpm format",
    "typecheck": "nuxt typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=verbose --coverage.enabled=false",
    "migrate": "tsx server/database/runMigrations.ts",
    "import:kml": "tsx scripts/import-google-maps-kml.ts",
    "gebieden": "tsx scripts/gebieden.ts",
    "test:e2e": "pnpm run typecheck:e2e && playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e:debug": "pnpm run typecheck:e2e && playwright test --debug=inspector",
    "test:e2e:ci": "pnpm run test:e2e --forbid-only --trace on",
    "format": "prettier --write eslint.config.mjs tsconfig.eslint.json tests/eslintConfig.test.ts app/composables/useMapResize.ts server/api/profile.post.ts",
    "format:check": "prettier --check eslint.config.mjs tsconfig.eslint.json tests/eslintConfig.test.ts app/composables/useMapResize.ts server/api/profile.post.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@iconify/vue": "5.0.4",
    "@jfungus/ratelimit-nuxt": "^0.0.2",
    "@mdi/font": "^7.4.47",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "2.6.1",
    "@pinia/nuxt": "0.11.2",
    "@sidebase/nuxt-auth": "^1.4.0",
    "@turf/bbox": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/invariant": "^7.4.0",
    "@turf/meta": "^7.4.0",
    "@turf/union": "^7.4.0",
    "@vueup/vue-quill": "^1.5.5",
    "@vueuse/core": "^13.3.0",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^3.0.4",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "bcryptjs": "^3.0.2",
    "color": "^5.0.3",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "geojson": "^0.5.0",
    "h3": "^2.0.8",
    "jose": "^6.2.13",
    "lodash": "^4.18.1",
    "mitt": "^3.0.1",
    "morgan": "^1.12.1",
    "nitropack": "^2.13.5",
    "nodemailer": "^10.2.1",
    "nuxt": "^4.6.2",
    "nuxt-nodemailer": "1.1.4",
    "nuxt-security": "2.7.0",
    "ofetch": "^1.5.1",
    "ol": "^10.11.0",
    "pinia": "^4.1.0",
    "proj4": "^2.22.0",
    "quill-image-compress": "^2.0.3",
    "sanitize-html": "^2.18.1",
    "vue3-openlayers": "^12.2.2",
    "vuetify-nuxt-module": "0.19.5"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/solar": "^1.2.13",
    "@iconify-json/tabler": "^1.2.42",
    "@nuxt/eslint-config": "^1.4.1",
    "@playwright/test": "^1.64.1",
    "@types/color": "^4.2.1",
    "@types/ejs": "^3.1.5",
    "@types/bcrypt": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "@xmldom/xmldom": "^0.9.12",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "tsx": "^4.20.3",
    "typescript": "~6.0.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.11",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.11",
    "vuetify": "^4.1.12"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "bcrypt"
    ],
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide",
      "core-js"
    ]
  },
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  }
}
